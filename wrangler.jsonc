{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poznamosti",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Odkaz na samého seba, meno sa musí zhodovať s menom workera
      "binding": "WORKER_SELF_REFERENCE",
      "service": "poznamosti"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "po-znamosti",
      "database_id": "fb785394-4f41-4e08-95ba-b444be76127f",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    // Kým nie je vlastná doména, BETTER_AUTH_URL nenastavuj: adresa sa zistí z požiadavky.
    // Po pripojení domény pridaj: "BETTER_AUTH_URL": "https://poznamosti.sk"
    // Odosielateľ musí byť z domény overenej v Resend (dovtedy onboarding@resend.dev).
    "EMAIL_FROM": "Po známosti <onboarding@resend.dev>",
    // "1" = kto má platnú pozvánku, zaregistruje sa bez e-mailového odkazu.
    // Kým Resend nemá overenú doménu, je to jediná cesta, ako sa pridajú noví ľudia.
    "INVITE_LOGIN": "1"
  },
  "observability": { "enabled": true }
}
