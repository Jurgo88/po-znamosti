{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "po-znamosti",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Odkaz na samého seba, meno sa musí zhodovať s menom workera
      "binding": "WORKER_SELF_REFERENCE",
      "service": "po-znamosti"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "po-znamosti",
      // Po `npx wrangler d1 create po-znamosti` sem vlož vrátené database_id
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://poznamosti.sk",
    "EMAIL_FROM": "Po známosti <prihlasenie@poznamosti.sk>"
  },
  "observability": { "enabled": true }
}
